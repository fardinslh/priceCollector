# Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini Model Identifier (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Optional: Affiliate tracking tags for link monetization
DIGIKALA_AFFILIATE_TAG=
TOROB_AFFILIATE_TAG=

# Optional: Telegram channel ID for the automatic deal publisher (e.g. @channelname or -100...)
# TELEGRAM_DEALS_CHANNEL_ID=
